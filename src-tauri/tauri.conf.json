{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lymbe AI",
  "version": "0.2.1",
  "identifier": "ai.lymbe.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lymbe AI",
        "label": "main",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "title": "Lymbe Schnellfrage",
        "label": "quick",
        "url": "index.html?window=quick",
        "width": 720,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true
      },
      {
        "title": "Lymbe",
        "label": "bubble",
        "url": "index.html?window=bubble",
        "width": 88,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Lymbe AI Desktop — KI-Mitarbeiter direkt auf deinem Rechner",
    "longDescription": "Native Desktop-App für die Lymbe AI Plattform. Schnellfrage per Hotkey, Live-Chat-Übernahme aus dem Tray, Wissensdatenbank per Drag-and-drop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "resources": [],
    "copyright": "© 2026 Flubber Pixels UG",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://app.lymbe.ai/api/desktop-app/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MDUzNDlBQjA2MDc2QUIKUldTcmRtQ3dtalFGVjBvZWJIZExtSzVIVmJGbTR6RDNRc0M5bk1iZ0tRWGxMZHYyNVJvK1hkVlkK"
    }
  }
}
